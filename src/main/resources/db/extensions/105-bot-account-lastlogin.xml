<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Gives the bot-owning account a lastlogin.

        RankingLoginTask reads accounts.lastlogin and calls getTime() on it with no null check.
        The column defaults to NULL, and nothing ever logs into the bot account, so the hourly
        ranking update threw a NullPointerException and aborted - taking the rankings for the real
        characters down with it, since one exception ends the whole pass.

        A separate changeset rather than an edit to 104 because 104 has already run on live
        databases, and Liquibase would refuse the changed checksum.
    -->
    <changeSet id="bot-account-lastlogin-1" author="cosmic-local">
        <sql splitStatements="true" endDelimiter=";">
            UPDATE accounts SET lastlogin = createdat WHERE name = 'botsystem' AND lastlogin IS NULL;
        </sql>
        <rollback>
            UPDATE accounts SET lastlogin = NULL WHERE name = 'botsystem';
        </rollback>
    </changeSet>

</databaseChangeLog>
