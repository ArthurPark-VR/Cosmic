<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Hands appearance over to BotLook.

        104 filled hair and face for every bot with a formula, which turned out to be both dull -
        black hair and default eyes on everyone, because the colour digits were always zero - and
        in the way, since a value in these columns is treated as a deliberate override and so
        suppressed the real derivation entirely.

        Zeroing them changes their meaning to "derive one". Anything non-zero from here on is a
        hand-edit and is respected, which is how these columns become useful rather than noise:
        set a hair id here and that character keeps it.

        The five written characters are unaffected either way - their looks live in code, chosen
        rather than generated.
    -->
    <changeSet id="bot-looks-1" author="cosmic-local">
        <sql splitStatements="true" endDelimiter=";">
            UPDATE bot_persona SET hair = 0, face = 0;
        </sql>
        <rollback>
            UPDATE bot_persona SET hair = 30030, face = 20000;
        </rollback>
    </changeSet>

</databaseChangeLog>
